# Copy this file to .env.local. Never commit the real file.
# Required by the default DeepSeek scene planner.
DEEPSEEK_API_KEY=

# Optional. Only needed when planner.provider or ai_fallback.provider is openai.
OPENAI_API_KEY=

# Optional. Smithsonian is skipped when this key is absent.
SMITHSONIAN_API_KEY=

# Optional. Openverse can be used without a token at a lower rate limit.
OPENVERSE_API_TOKEN=
